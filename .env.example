# Пример окружения COMMONS. Настоящий .env никогда не коммитится (.gitignore).
# Копируй в .env и заполняй локально.

# Домашняя папка органов (адаптеры, локальные развёртывания)
COMMONS_ORGAN_HOME=./organs

# Журнал крови (append-only, SPEC-0003)
COMMONS_BLOOD_LOG=./blood/journal.jsonl

# Метаболизм
OLLAMA_HOST=http://localhost:11434
LLAMA_SERVER_URL=http://localhost:8080

# Бюджет метаболизма (SPEC-0001 G3; 0 = без лимита до M3)
COMMONS_TOKEN_BUDGET_PER_DAY=0
COMMONS_SECONDS_BUDGET_PER_DAY=0
